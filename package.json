{
  "name": "ai-office",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "start": "node scripts/office.mjs start",
    "stop": "node scripts/office.mjs stop",
    "restart": "node scripts/office.mjs restart",
    "status": "node scripts/office.mjs status",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test \"hooks/*.test.mjs\" \"scripts/*.test.mjs\" && pnpm -r run test",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "usage:import": "node scripts/import-usage.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
